# Request a driving mode from isaacbot_amr_drive_mode (isaacbot_amr_orchestrator).
# Refused, with the reason in message, when the mode's prerequisites are missing
# (e.g. AUTOMATIC without the mission manager).

uint8 mode      # isaacbot_amr_msgs/DriveMode MANUAL, ASSISTED or AUTOMATIC
---
bool success
string message
uint8 mode      # Mode in force after the call
