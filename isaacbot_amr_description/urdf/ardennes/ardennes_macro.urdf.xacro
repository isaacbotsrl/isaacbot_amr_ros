<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro">

  <xacro:macro
    name="ardennes_robot"
    params="wheel_config_file
            battery_config_file
            controller_config_file
            use_sim:=false
            imu_xyz:='0.0 0.0 0.0'
            imu_rpy:='0.0 0.0 0.0'
            lidar_xyz:='0.0 0.0 0.0'
            lidar_rpy:='0.0 0.0 0.0'
            gps_xyz:='0.0 0.0 0.0'
            gps_rpy:='0.0 0.0 0.0'
            camera_xyz:='0.25 0.0 0.2'
            camera_rpy:='0.0 0.0 0.0'
            use_camera:=false
            namespace:=''">

    <xacro:if value="${use_sim}">
      <xacro:property name="imu_xyz" value="-0.09 0.0 0.2" />
      <xacro:property name="imu_rpy" value="0.0 0.0 0.0" />
      <!-- Keep the ISAACBOT_AMR_SYSTEM_MOUNT_LIDAR_* mount when one is set; with the all-zero default the
           gpu_lidar would sit inside the body mesh, so lift it above. Its lowest ring
           (-15 deg) must clear the far corner of the front arch's top (z = 0.555 at
           x 0.251, y +/-0.253, 0.356 m out), which needs >= 0.555 + 0.356 * tan(15 deg)
           = 0.650, and the body's far corner (top z = 0.30, 0.52 m out), which needs
           >= 0.44; 0.68 clears both (0.62 was verified to hit the arch in Gazebo). Lower,
           the isaacbot sees itself and the costmaps mark obstacles inside the footprint. -->
      <xacro:if value="${[float(v) for v in str(lidar_xyz).split()] == [0.0, 0.0, 0.0]}">
        <xacro:property name="lidar_xyz" value="0.0 0.0 0.68" />
      </xacro:if>
      <!-- Likewise the Gazebo camera (use_camera only, so other simulations keep camera_link
           where it was): the assumed real mount (0.25 0 0.2, isaacbot_amr_load_urdf) is inside the body
           mesh (x up to 0.413, top z = 0.30), where it would see only the body. Keep a
           ISAACBOT_AMR_SYSTEM_MOUNT_CAMERA_* mount when one is set, else put it just ahead of the front face, above
           the body top. -->
      <xacro:if value="${use_camera and [float(v) for v in str(camera_xyz).split()] == [0.25, 0.0, 0.2]}">
        <xacro:property name="camera_xyz" value="0.43 0.0 0.32" />
      </xacro:if>
    </xacro:if>

    <xacro:property name="wheel_config" value="${xacro.load_yaml(wheel_config_file)}" />
    <!-- wheelbase and wheel_separation are full centre-to-centre distances, so each
         mount point sits at half of them (REP-103: +x forward, +y left, +z up). -->
    <xacro:property name="wheel_mount_point_x" value="${wheel_config['wheelbase'] / 2.0}" />
    <xacro:property name="wheel_mount_point_y" value="${wheel_config['wheel_separation'] / 2.0}" />
    <!-- Height of the wheel axis above body_link; also fixes the ground plane. From the
         SolidWorks export (joint_*_* origin z in solidworks_exported/.../urdf/*.csv). -->
    <xacro:property name="wheel_mount_point_z" value="0.037363" />

    <!-- Isaacbot base macros -->
    <xacro:include filename="$(find isaacbot_amr_description)/urdf/ardennes/base.urdf.xacro" ns="body" />
    <!-- Isaacbot wheel macros -->
    <xacro:include filename="$(find isaacbot_amr_description)/urdf/common/wheel.urdf.xacro" ns="wheel" />

    <xacro:if value="${use_sim}">
      <!-- Battery macros -->
      <xacro:include filename="$(find isaacbot_amr_description)/urdf/common/battery.urdf.xacro" ns="battery" />
    </xacro:if>
    
    <!-- IMU macros -->
    <xacro:include filename="$(find isaacbot_amr_description)/urdf/common/imu.urdf.xacro" ns="imu" />
    <!-- Lidar macros -->
    <xacro:include filename="$(find isaacbot_amr_description)/urdf/common/lidar.urdf.xacro" ns="lidar" />
    <!-- GPS macros -->
    <xacro:include filename="$(find isaacbot_amr_description)/urdf/common/gps.urdf.xacro" ns="gps" />
    <!-- Depth camera macros -->
    <xacro:include filename="$(find isaacbot_amr_description)/urdf/common/depth_camera.urdf.xacro" ns="depth_camera" />
    <!-- Gazebo system macros -->
    <xacro:include filename="$(find isaacbot_amr_description)/urdf/common/gazebo_system.urdf.xacro" ns="gazebo_system" />
    
    <!-- Isaacbot body -->
    <xacro:body.body
      wheel_radius="${wheel_config['tyre_radius']}"
      wheel_mount_point_z="${wheel_mount_point_z}"
      imu_xyz="${imu_xyz}"
      imu_rpy="${imu_rpy}"
      lidar_xyz="${lidar_xyz}"
      lidar_rpy="${lidar_rpy}"
      gps_xyz="${gps_xyz}"
      gps_rpy="${gps_rpy}"
      camera_xyz="${camera_xyz}"
      camera_rpy="${camera_rpy}"
      use_sim="${use_sim}" />

    <!-- Isaacbot wheel -->
    <xacro:wheel.wheel
      config="${wheel_config}"
      mount_point_x="${wheel_mount_point_x}"
      mount_point_y="${wheel_mount_point_y}"
      mount_point_z="${wheel_mount_point_z}"
      prefix="fl" />

    <!-- Isaacbot wheel -->
    <xacro:wheel.wheel
      config="${wheel_config}"
      mount_point_x="${wheel_mount_point_x}"
      mount_point_y="${wheel_mount_point_y}"
      mount_point_z="${wheel_mount_point_z}"
      prefix="fr" />

    <!-- Isaacbot wheel -->
    <xacro:wheel.wheel
      config="${wheel_config}"
      mount_point_x="${wheel_mount_point_x}"
      mount_point_y="${wheel_mount_point_y}"
      mount_point_z="${wheel_mount_point_z}"
      prefix="rl" />

    <!-- Isaacbot wheel -->
    <xacro:wheel.wheel
      config="${wheel_config}"
      mount_point_x="${wheel_mount_point_x}"
      mount_point_y="${wheel_mount_point_y}"
      mount_point_z="${wheel_mount_point_z}"
      prefix="rr" />

    <!-- ROS2 Controller. No namespace prefix in the name: ros2_control names the component's
         node after it, inside the controller manager's namespace (/isaacbot/isaacbot_amr_system_node). -->
    <ros2_control name="isaacbot_amr_system_node" type="system">
      <!-- Joints -->
      <joint name="fl_wheel_base_to_fl_wheel_joint">
        <command_interface name="velocity" />
        <state_interface name="position" />
        <state_interface name="velocity" />
        <state_interface name="effort" />
      </joint>
      <joint name="fr_wheel_base_to_fr_wheel_joint">
        <command_interface name="velocity" />
        <state_interface name="position" />
        <state_interface name="velocity" />
        <state_interface name="effort" />
      </joint>
      <joint name="rl_wheel_base_to_rl_wheel_joint">
        <command_interface name="velocity" />
        <state_interface name="position" />
        <state_interface name="velocity" />
        <state_interface name="effort" />
      </joint>
      <joint name="rr_wheel_base_to_rr_wheel_joint">
        <command_interface name="velocity" />
        <state_interface name="position" />
        <state_interface name="velocity" />
        <state_interface name="effort" />
      </joint>
      
      <xacro:if value="${use_sim}">
        <!-- IMU interfaces -->
        <xacro:imu.imu_interface use_sim="${use_sim}" namespace="${namespace}" />
      </xacro:if>
      
      <!-- Hardware controller plugin -->
      <hardware>
        <xacro:if value="${use_sim}">
          <!-- Gazebo simulation system contorller -->
          <plugin>gz_ros2_control/GazeboSimSystem</plugin>
        </xacro:if>

        <xacro:unless value="${use_sim}">
          <!-- Hardware controller system interface -->
          <plugin>isaacbot_amr_hardware_interface/ArdennesSystem</plugin>

          <!-- Modbus TCP endpoint for the safety controller (E-Stop / GPIO) -->
          <param name="modbus_host">192.168.88.11</param>
          <param name="modbus_port">502</param>
          <!-- 0 = retry the initial Modbus connection forever (blocking on_configure() until
               reachable, matching the previous hardcoded behavior). Set to a positive count to
               instead fail on_configure() cleanly after that many attempts. -->
          <param name="modbus_connection_retry_count">0</param>
          <param name="modbus_connection_retry_delay_ms">1000</param>
          <!-- Per-transaction Modbus response timeout (ms). Bounds how long one stalled read or
               write can hold the safety link and delay the watchdog heartbeat below, so it must
               stay comfortably under safety_wdg_kick_period_ms. Optional - omitting it keeps the
               compiled-in kDefaultResponseTimeoutMs (500), which is longer than a kick period
               and is why a single slow transaction used to be able to trip the relay. -->
          <param name="modbus_response_timeout_ms">150</param>

          <!-- Period (ms) of the CPU watchdog heartbeat toggle on GPIO_CPU_WDG_HEARTBEAT
               (COIL_1). The safety relay latches the E-Stop if this level stops changing for
               longer than its watchdog window, measured at ~1 s on the A1, so this value is
               dimensioned against real hardware and is not a free tuning knob: 200 ms gives ~5x
               margin, enough to absorb several consecutive ticks lost to Modbus contention. The
               heartbeat runs on its own thread with absolute steady_clock deadlines and does not
               share a lock hold with the IO poll below. Raise only with a re-measured window;
               lowering it costs Modbus bandwidth but is otherwise safe. -->
          <param name="safety_wdg_kick_period_ms">200</param>

          <!-- Period (ms) of the discrete-IO poll that refreshes the cache read() serves to
               hardware_interface/safety_status, safety_command_echo and the E-Stop mirror.
               Telemetry only - a missed poll degrades freshness and is caught by the 1.0 s
               safety_status staleness timeout in isaacbot_amr_twist_mux's motion lock (gpio_timeout);
               it never endangers the relay's watchdog window. 100 ms keeps link duty low; it is also the
               floor on how quickly software notices a latch trip, which is defense-in-depth
               behind the contactor opening in hardware. -->
          <param name="safety_io_poll_period_ms">100</param>

          <!-- How long (ms) the latch-reset coil is held true before being driven back to false.
               The reset is a pulse, not a level; it used to be written true-then-false with no
               dwell, making it one Modbus round-trip wide and narrower than anyone had checked
               against the relay's discrete-input filter. A pulse the relay cannot see fails
               silently - the service returns success and the latch stays held. Optional;
               omitting it keeps kDefaultLatchResetPulseMs (100). Narrow it only against a
               scope measurement of the relay input. -->
          <param name="safety_latch_reset_pulse_ms">100</param>

          <!-- Driver controller update frequency and maximum attempts to initilize and activate -->
          <param name="driver_states_update_frequency">20.0</param>
          <param name="max_isaacbot_amr_driver_initialization_attempts">3</param>
          <param name="max_isaacbot_amr_driver_activation_attempts">3</param>

          <!-- Consecutive-cycle thresholds for the IsaacbotErrorFilter: number of consecutive
               failed/faulty cycles before a category latches into an active (debounced) error.
               Reported only via diagnostics ("system errors" task) and the error/comm_error
               message fields - never gates read()/write() return codes or triggers a lifecycle
               transition. The fault-flag category has no URDF param: it is hardcoded to 1
               (immediate escalation, no debounce). Counted in controller_manager cycles: 4 at
               50 Hz is the same 80 ms window that 2 was at 25 Hz. -->
          <param name="max_write_cmds_errors_count">4</param>
          <param name="max_read_motor_states_errors_count">4</param>
          <param name="max_read_driver_state_errors_count">4</param>

          <!-- Max time (ms) since the last Phidget SDK telemetry callback (position/current/
               temperature) before a wheel driver is considered to have a communication error
               (e.g. a USB disconnect). Tune against the measured minDataInterval on the real
               boards if false positives/slow detection are observed. -->
          <param name="driver_comm_timeout_ms">300</param>

          <!-- Max time (ms) between commands before each DCC1020's own hardware watchdog trips:
               the controller disengages the motor (braking, see motor_failsafe_braking_enabled),
               independent of software E-Stop state - a defense-in-depth backstop for e.g. a hung
               RT loop. Every velocity target sent feeds it, and write() keeps sending zero targets
               while motion is inhibited (E-Stop), so only a stalled write() loop trips it. A trip
               is latched (motor_failsafe_tripped_error in diagnostics) and only cleared by the
               hardware_interface/sw_e_stop_latch_reset service, which re-opens the channel.
               Must lie within the board's getMin/MaxFailsafeTime() (checked at activation).
               Optional - omitting it keeps the compiled-in kDefaultMotorFailsafeTimeoutMs (500).
               The watchdog can be switched off with motor_failsafe_enabled - for instrumented
               builds only: with it off, a stalled write() loop leaves each wheel at its last
               velocity target. -->
          <param name="motor_failsafe_timeout_ms">500</param>

          <!-- On-board failsafe ENABLED (the default). Set it to false only for measurements that
               stall the RT write() loop on purpose: with it off, a stalled loop leaves each wheel
               at its last velocity target, and the PLC heartbeat does not catch a loop-only stall
               - wheels lifted or low speed, RC E-Stop in reach. -->
          <param name="motor_failsafe_enabled">true</param>

          <!-- Brake (true) or coast (false) when the failsafe trips. Optional, default true, so a
               tripped wheel stops instead of rolling on; the DCC1020's own default is coast. -->
          <param name="motor_failsafe_braking_enabled">true</param>

          <!-- DCC1020 motor current limit in A (checked against the board's range at configure).
               The motor stalls at 16 A on 24 V, and a direction reversal can briefly reach ~2x
               stall as back-EMF adds to the supply, so the limit is what protects motor, driver
               and gearbox. 13.4 A is the motor's rated current (seller listing, not a datasheet:
               docs/hardware/components.md), which fits 250 W of output at ~78 % efficiency. It is
               a continuous limit, so the motor may run at it indefinitely. ASSUMPTION until the
               rating is checked on the bench. Optional - omitting it keeps the compiled-in
               kDefaultMotorCurrentLimit (10.0). -->
          <param name="motor_current_limit">13.4</param>

          <!-- DCC1020 on-board velocity loop (MotorVelocityController). The controller is
               rescaled to motor-shaft RPM, so velocities are motor RPM and accelerations RPM/s.
               Every one of these is optional: omitted, the board keeps its own default and the
               driver logs the value it runs with at configure ("Motor hub port N ... Kp=..."),
               which is the starting point for tuning. -->

          <!-- Current allowed briefly above motor_current_limit before the board scales down to it
               (must be >= motor_current_limit). Keeps the 15 A the isaacbot accelerated with on
               the ground on 2026-10-31: straight ramps averaged 5-9 A with peaks at 15 A, and the
               worst case (0.8 m/s + 1.5 rad/s step) averaged up to 14.6 A on an outer wheel for
               the 0.4 s ramp. Stays under the 16 A stall current. -->
          <param name="motor_surge_current_limit">15.0</param>

          <!-- Dangerous-stall threshold, motor RPM; 0 disables stall protection. Phidgets: set it to
               the lowest speed the motor is expected to run at; a higher value trips sooner. The
               slowest motion measured on the ground is 0.05 m/s = 67 RPM. 30 RPM (0.02 m/s) sits
               below that. ASSUMPTION until confirmed on the ground: no fault_flag.motor_stall on
               hard starts and in-place turns, and a trip with a wheel held. A trip disengages that
               wheel and latches until hardware_interface/sw_e_stop_latch_reset. WheelStallMonitor
               in the hardware interface checks for the same fault independently. -->
          <param name="motor_stall_velocity_rpm">30</param>

          <!-- motor_failsafe_current_limit (A, current while the failsafe state brakes) stays at
               the board default: lowering it could lengthen a watchdog stop, and failsafe braking
               has not been measured. The driver logs the default at configure ("failsafe=").
               TBD: set it after measuring a watchdog stop.
          <param name="motor_failsafe_current_limit">TBD</param>
          -->

          <!-- Motor inductance in H, set when each channel attaches so the DCC1020 skips its motor
               characterization (the beeps) at every open. Without it the board measures at
               open, which fails (error 0x1011, latched motor_setup_fault) while the motor
               contactor is open. Measured by the boards themselves on 2026-10-25, contactor
               bridged, read from the "inductance=" configure log line: port 0 0.000585, port 1
               0.000559, port 5 0.000581, port 4 0.001014. 0.000575 is the mean of ports 0, 1 and
               5. Port 4 is ~1.8x the others (and reports a 5 A board-default surge limit against
               15 A on the rest) - TBD: check its motor and wiring, then revisit this value. -->
          <param name="motor_inductance">0.000575</param>

          <!-- DCC1020 on-board velocity loop gains (motor RPM units). Tuned on 2026-10-25 with the
               wheels lifted, by 0.05 / 0.2 / 0.5 m/s velocity steps on joint_states. The board
               defaults (Kp 0.00683, Ki 0.0683) left a 0.5-0.8 rad/s wheel oscillation that kept
               going at a zero target once the wheels had moved (backlash limit cycle); halving Ki
               did nothing, Kp was the cause. With these: steady-state error < 0.7 %, overshoot
               4-17 %, ripple ~0.1 rad/s at 0.2 m/s and ~8 % of target at 0.5 m/s, wheels still at
               rest after a stop. Rear left (hub port 4) ripples most in every test. Not yet
               checked under load on the ground. -->
          <param name="velocity_kp">0.0017</param>
          <param name="velocity_ki">0.0341</param>
          <param name="velocity_kd">0</param>
          <!-- Zero-target band in which the controller lets go instead of holding the wheel. -->
          <param name="velocity_deadband_rpm">5</param>

          <!-- On-board trapezoidal ramp, motor RPM/s. diff_drive owns the body acceleration
               (wheel_01_controller.yaml); this only backs it up per wheel, and the board
               interpolates between diff_drive's 20 ms (50 Hz) command steps. It sits just above
               the worst wheel demand at the diff_drive limits, so it never caps an accelerating
               turn: outer wheel 2.7 m/s^2 + 3.74 rad/s^2 * 0.5118 m = 4.61 m/s^2 = 27.9 rad/s^2
               at r = 0.1651, * 23.3 * 60 / 2pi = 6213 RPM/s, rounded up. Was 1890 (= 1.4 m/s^2,
               the DCC1000-era diff_drive limit). Whether the motors reach it at
               motor_current_limit is TBD on the ground. -->
          <param name="motor_acceleration_rpm_s">6300</param>

          <!-- Motor parameters -->
          <param name="motor_torque_constant">0.11</param>
          <!-- Clamp on the velocity target sent to each DCC1020, motor RPM. -->
          <param name="max_rpm_motor_speed">2800</param>
          <param name="gear_ratio">23.3</param>
          <param name="gearbox_efficiency">0.70</param>
          <!-- The Phidget driver reports raw current feedback in units of 10 mA (see
               PhidgetMotorDriver::currentChangeHandler - an int16 in mA would overflow below the
               DCC1020's 50 A rating); this scales it to amps before it's combined with
               motor_torque_constant/gear_ratio/gearbox_efficiency to compute torque (see
               domain/driver_data_snapshot.cpp). A different driver backend would supply its own
               raw-current unit scale here. -->
          <param name="raw_current_to_amps_scale">0.01</param>
          <!-- Encoder parameters -->
          <param name="encoder_resolution">1024</param>

          <!-- Deadband (rad/s at the wheel) below which a velocity command counts as zero for
               the "can't clear the E-Stop while the isaacbot is still being commanded to move"
               invariant (see domain/emergency_stop.cpp). Optional: omitting it keeps the
               compiled-in kDefaultVelocityCommandZeroTolerance (0.01).

               0.01: diff_drive writes the wheel joints directly, so its zero command reaches the
               hardware as exactly 0. It was 0.4 while host wheel PIDs sat in between (DCC1000
               era): their frozen PI integrator kept a nonzero command while motion was
               inhibited. velocity_state_zero_tolerance below closes the real hazard regardless.
               TBD: confirm an E-Stop reset succeeds at rest on the isaacbot. -->
          <param name="velocity_command_zero_tolerance">0.01</param>

          <!-- Deadband (rad/s at the wheel) below which a *measured* wheel velocity counts as
               "not moving", the second half of the same invariant. Unlike the command check
               above this has no PID artifact to work around - a stationary wheel reads zero
               whatever the integrator remembers - so it is the condition that actually prevents
               clearing the E-Stop while the isaacbot is still rolling. Optional; omitting it keeps
               kDefaultVelocityStateZeroTolerance (0.05). 0.05 rad/s is ~8 mm/s, above 20 Hz
               encoder quantisation and far below walking pace. -->
          <param name="velocity_state_zero_tolerance">0.05</param>

        </xacro:unless>
      </hardware>
    </ros2_control>

    <!-- Instantiate IMU -->
    <xacro:imu.imu use_sim="${use_sim}" reference_frame="imu_link" namespace="${namespace}" />
    <!-- Instantiate LIDAR -->
    <xacro:lidar.lidar use_sim="${use_sim}" reference_frame="lidar_link" namespace="${namespace}" />
    <!-- Instantiate GPS -->
    <xacro:gps.gps use_sim="${use_sim}" reference_frame="gps_link" namespace="${namespace}" />
    <!-- Instantiate the depth camera (Gazebo only, and only with ISAACBOT_AMR_SYSTEM_USE_CAMERA) -->
    <xacro:depth_camera.depth_camera
      use_sim="${use_sim and use_camera}" reference_frame="camera_link" namespace="${namespace}" />

    <xacro:if value="${use_sim}">
      <!-- Instantiate Battery -->
      <xacro:battery.battery battery_config_file="${battery_config_file}" namespace="${namespace}" />
      <!-- Instantiate Gazebo System -->
      <xacro:gazebo_system.controller controller_config_file="${controller_config_file}" namespace="${namespace}" />
    </xacro:if>

  </xacro:macro>

</robot>