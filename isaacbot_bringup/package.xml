<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>isaacbot_bringup</name>
  <version>1.0.1</version>
  <description> The package containing the default launch files and configuration used to start Isaacbot</description>
  <maintainer email="potlogradu@gmail.com">radupotlog</maintainer>
  <license>Apache License 2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend condition="$ISAACBOT_AMR_ROS_BUILD_TYPE == hardware">launch</exec_depend>
  <exec_depend condition="$ISAACBOT_AMR_ROS_BUILD_TYPE == hardware">launch_ros</exec_depend>
  
  <!-- Isaacbot dependency -->
  <exec_depend condition="$ISAACBOT_AMR_ROS_BUILD_TYPE == hardware">isaacbot_controller</exec_depend>
  <exec_depend condition="$ISAACBOT_AMR_ROS_BUILD_TYPE == hardware">isaacbot_localization</exec_depend>
  <exec_depend condition="$ISAACBOT_AMR_ROS_BUILD_TYPE == hardware">isaacbot_diag_manager</exec_depend>
  <exec_depend condition="$ISAACBOT_AMR_ROS_BUILD_TYPE == hardware">isaacbot_twist_mux</exec_depend>
  <exec_depend condition="$ISAACBOT_AMR_ROS_BUILD_TYPE == hardware">isaacbot_crsf_teleop</exec_depend>
  <exec_depend condition="$ISAACBOT_AMR_ROS_BUILD_TYPE == hardware">isaacbot_battery</exec_depend>
  <exec_depend condition="$ISAACBOT_AMR_ROS_BUILD_TYPE == hardware">isaacbot_utils</exec_depend>
  <exec_depend condition="$ISAACBOT_AMR_ROS_BUILD_TYPE == hardware">isaacbot_safety</exec_depend>
  <exec_depend condition="$ISAACBOT_AMR_ROS_BUILD_TYPE == hardware">isaacbot_led</exec_depend>
  <exec_depend condition="$ISAACBOT_AMR_ROS_BUILD_TYPE == hardware">isaacbot_udp_driver</exec_depend>

  <!-- Isaacbot foxglove bridge dependency -->
  <exec_depend condition="$ISAACBOT_AMR_ROS_BUILD_TYPE == hardware">foxglove_bridge</exec_depend>

  <!-- Isaacbot rosbridge dependency -->
  <exec_depend condition="$ISAACBOT_AMR_ROS_BUILD_TYPE == hardware">rosbridge_server</exec_depend>

  <!-- Isaacbot zenoh dependency -->
  <exec_depend condition="$ISAACBOT_AMR_ROS_BUILD_TYPE == hardware">rmw_zenoh_cpp</exec_depend>
  
  <test_depend>ament_cmake_pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
